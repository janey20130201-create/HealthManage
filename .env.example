# Copy this file to .env and replace placeholder values.
# Never commit a real API key to source control.

# Public Data Portal (data.go.kr) service key
MFDS_SERVICE_KEY=replace_with_your_data_go_kr_service_key

# MFDS drug product approval information API
MFDS_DRUG_API_BASE_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07

# Local API proxy settings
API_PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
API_REQUEST_TIMEOUT_MS=10000

# OpenAI API settings
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.3-chat-latest
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Supabase project URL and browser-safe publishable key (for future app integration).
# Never place a service_role/secret key in browser JavaScript or Git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
